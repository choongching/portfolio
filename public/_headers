# Cloudflare Pages response headers.
# Vite fingerprints everything in /assets, and the fonts never change, so both can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/trustana-*
  Cache-Control: public, max-age=604800
/media/*
  Cache-Control: public, max-age=604800
